{
  "name": "url-web-preview",
  "displayName": "小小说",
  "description": "输入网址或书名，在 VS Code 中搜索并阅读小说。",
  "version": "0.0.16",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:urlWebPreview.open",
    "onView:urlWebPreview.readerView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "urlWebPreviewSidebar",
          "title": "小小说",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "urlWebPreviewSidebar": [
        {
          "id": "urlWebPreview.readerView",
          "name": "小小说",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "urlWebPreview.open",
        "title": "小小说: 打开网址或搜索书名",
        "category": "小小说"
      }
    ],
    "keybindings": [
      {
        "command": "urlWebPreview.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "node scripts/check-syntax.js",
    "test": "npm run lint",
    "package:vsix": "npx @vscode/vsce package",
    "publish:marketplace": "npx @vscode/vsce publish"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
